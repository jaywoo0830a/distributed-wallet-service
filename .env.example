# =============================================================================
# Distributed Wallet Service — environment variables
# Copy this file to `.env` and fill in values before running `run/dev/up.sh`
# or `run/prod/up.sh`. Variables marked REQUIRED will cause compose to refuse
# to start if unset.
# =============================================================================

# --- Runtime mode ---
# `mock` runs without real blockchain nodes; `live` uses bitcoind / monero-wallet.
WALLET_MODE=mock

# --- Host-side ports ---------------------------------------------------------
# Only nginx is exposed publicly. Override HTTP_PORT when co-hosting multiple
# sites on the same server (e.g. 8080, 8081, ...). The container still listens
# on 80 internally; only the host-side mapping changes.
HTTP_PORT=80

# --- Database (MySQL) --------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme          # REQUIRED — set a strong value in production
DB_NAME=wallet_service

# --- Cache / queue (Redis) ---------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme       # REQUIRED — set a strong value in production

# --- Bitcoin node (regtest in dev) -------------------------------------------
BTC_RPC_URL=http://bitcoind:18443
BTC_RPC_USER=devuser
BTC_RPC_PASS=changeme         # REQUIRED — set a strong value in production

# --- Monero wallet RPC (testnet in dev) --------------------------------------
XMR_RPC_URL=http://monero-wallet:28083/json_rpc
XMR_RPC_USER=monero
XMR_RPC_PASS=changeme         # REQUIRED — set a strong value in production
