WALLET_MODE=mock

# Host port nginx will bind to. Change this if another service already uses 80.
HTTP_PORT=80

DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=wallet_service

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=devpass

BTC_RPC_URL=http://bitcoind:18443
BTC_RPC_USER=devuser
BTC_RPC_PASS=devpass

XMR_RPC_URL=http://monero-wallet:28083/json_rpc
XMR_RPC_USER=monero
XMR_RPC_PASS=devpass